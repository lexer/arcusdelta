# Copy to .env and fill in. .env is gitignored — never commit it.

# PRODUCTION WALLET MNEMONIC. Holds real funds. Required, no default.
# SEED="word word word ... word"

# Robinhood Chain mainnet
RPC_URL="https://rpc.mainnet.chain.robinhood.com"
CHAIN_ID=4663

# Arcus spot router (hosted, no API key required)
ARCUS_ROUTER_URL="https://router.spot.arcus.xyz/v1"

# Stock token to buy. Default is NVDA on Robinhood Chain.
STOCK_TOKEN_ADDRESS="0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC"

# How much USDG to spend per buy, as a human decimal amount.
USDG_BUY_AMOUNT="100"

# Slippage tolerance in basis points. 1 bps = 0.01%.
SLIPPAGE_BPS=1

# --- Uniswap v3 liquidity position ---

# Half-width of the LP range, as a percentage either side of the pool price.
RANGE_DEVIATION_PERCENT=3

# Pool fee tier, in hundredths of a bip (3000 = 0.3%). tickSpacing is derived
# from this via the factory, not configured separately.
POOL_FEE=3000

# Bound on the amounts the mint may pull, in basis points over the computed need.
LP_SLIPPAGE_BPS=50

# Deadline applied to the mint transaction.
MINT_DEADLINE_SECONDS=300

# --- Position monitoring ---

# How often to check whether the pool has left the position's range.
POOL_CHECK_INTERVAL_SECONDS=30

# Consecutive out-of-range readings required before closing. Guards against a
# momentary wick that mean-reverts.
EXIT_CONFIRMATIONS=3

# Headroom below the expected amounts when closing, guarding the burn against
# being sandwiched.
CLOSE_SLIPPAGE_BPS=100
