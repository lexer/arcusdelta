{
  "name": "arcusamm",
  "version": "0.1.0",
  "private": true,
  "description": "Automated market-making bot for tokenized stocks on Arcus Spot and Robinhood Chain",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "buy": "tsx src/cli/buy.ts",
    "funding": "tsx src/cli/funding.ts",
    "apikey": "tsx src/cli/apikey.ts",
    "cycle": "tsx src/cli/cycle.ts",
    "quote": "tsx src/cli/quote.ts",
    "deposit": "tsx src/cli/deposit.ts",
    "position": "tsx src/cli/position.ts",
    "monitor": "tsx src/cli/monitor.ts",
    "exit": "tsx src/cli/exit.ts",
    "pnl": "tsx src/cli/pnl.ts",
    "lint": "gts lint",
    "fix": "gts fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcus-xyz/arcus-spot-sdk": "^1.0.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@uniswap/sdk-core": "^7.19.0",
    "@uniswap/v3-sdk": "^3.31.1",
    "gts": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
