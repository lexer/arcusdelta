# Copy to .env and fill in. .env is gitignored — never commit it.
#
# The stock symbols the bot trades live in symbols.json (copy from
# symbols.example.json), not here. Everything below is the *default* each
# symbol falls back to when it doesn't override that field itself.

# --- Secrets ---

# PRODUCTION WALLET MNEMONIC. Holds real funds. Required, no default.
# SEED="word word word ... word"

# Ed25519 private key for the Arcus perps API, 32 bytes of hex. Generate and
# register it with `npm run apikey`, which prints this line for you.
#
# Treat it exactly like SEED: anything holding it can place and cancel orders
# on the perps account. Optional — read-only and spot-only commands run
# without it; the perp order path fails fast when it is missing.
# ARCUS_API_PRIVATE_KEY="..."

# --- Endpoints ---

# Robinhood Chain mainnet
RPC_URL="https://rpc.mainnet.chain.robinhood.com"
CHAIN_ID=4663

# Arcus spot router (hosted, no API key required)
ARCUS_ROUTER_URL="https://router.spot.arcus.xyz/v1"

# Arcus perpetuals gateway
ARCUS_API_URL="https://api.arcus.xyz"

# Perps subaccount to trade. 0 unless you deliberately use another.
ARCUS_ACCOUNT_INDEX=0

# --- Pair sizing and spot execution (defaults) ---

# The pair notional: USDG spent acquiring the spot leg, with the perp short
# sized to match. Fallback when a symbols.json entry omits its own — no
# default of its own, so a symbol with no amount from either source is a
# config error naming that symbol.
# USDG_BUY_AMOUNT="100"

# Slippage tolerance on spot quotes, in basis points. 1 bps = 0.01%.
SLIPPAGE_BPS=1

# Split the spot leg into this many chunks, each with its own fresh quote,
# executed TWAP_INTERVAL_SECONDS apart. 1 (the default) disables chunking.
TWAP_CHUNKS=1
TWAP_INTERVAL_SECONDS=10

# Refuse a spot buy whose price — against Robinhood's own feed — has moved
# more than this many basis points.
MAX_PRICE_IMPACT_BPS=100

# --- Pair monitoring (defaults) ---

# Realizable PnL, in basis points of the capital deployed, at which
# `npm run watch` flags a pair as worth closing. May be negative, which
# expresses a stop rather than a target.
MIN_CLOSE_PROFIT_BPS=25

# How far the spot and perp sizes may drift apart before a position stops
# being recognized as one of this bot's pairs.
MAX_DELTA_BPS=100

# How often `npm run watch` re-values open pairs.
PAIR_CHECK_INTERVAL_SECONDS=60

# --- Funding analysis (defaults) ---

# How far back `npm run funding` looks. A quarter by default so at least one
# ex-dividend date falls inside the window: dividends reach the perp as
# funding paid to longs, so a shorter lookback overstates a short's carry.
FUNDING_LOOKBACK_DAYS=90

# Delay between funding-history pages. The endpoint costs 20 weight against a
# bucket refilling at 25/second, so anything under ~800ms gets throttled.
FUNDING_REQUEST_INTERVAL_MS=1000

# --- Logging (defaults) ---

# Daily structured run logs, and the append-only record of every fill and
# funding payment. Both gitignored.
LOG_DIR=logs
JOURNAL_PATH=logs/executions.jsonl
