  "description": "Delta-neutral basis bot: long tokenized stocks on Arcus Spot, short the matching Arcus perp, collect funding",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "funding": "tsx src/cli/funding.ts",
